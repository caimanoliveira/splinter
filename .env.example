# Copy to .env and fill in real values. .env is gitignored.

# Slack Incoming Webhook for the morning briefing.
# Create at https://api.slack.com/apps → Incoming Webhooks → Add New Webhook.
# Point it at the channel or DM you want briefings delivered to.
SLACK_WEBHOOK_URL=

# Optional: override the hour used by the scheduled briefing (24h, America/Sao_Paulo).
# MORNING_BRIEFING_HOUR=8
